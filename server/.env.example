# MongoDB connection string for the Smartnest backend
MONGODB_URI=mongodb://localhost:27017/smartnest

# Optional alternate names
# DATABASE_URL=mongodb://localhost:27017/smartnest
# MONGO_URI=mongodb://localhost:27017/smartnest

# Backend server port
PORT=5000

# The frontend URL allowed by CORS
FRONTEND_URL=http://localhost:19006

# JWT secret for user authentication
JWT_SECRET=your_jwt_secret_here

# Paystack secret key for payment processing
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
